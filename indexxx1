<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Ignición en Carga — MyGeotab Add-In</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
  body { background: #f5f7fa; color: #222; font-size: 13px; }
  #header { background: #1a3a5c; color: #fff; padding: 14px 24px; }
  #header h1 { font-size: 15px; font-weight: 600; }
  #header span { font-size: 11px; opacity: .7; }
  #controls {
    background: #fff; border-bottom: 1px solid #dde3ec;
    padding: 10px 24px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  }
  #controls label { font-size: 12px; color: #555; }
  #controls select, #controls input[type=date] {
    border: 1px solid #cdd3db; border-radius: 4px; padding: 5px 8px; font-size: 12px;
  }
  .btn { border: none; border-radius: 4px; padding: 6px 16px; font-size: 12px; cursor: pointer; color: #fff; }
  .btn-run  { background: #1a6fc4; } .btn-run:hover  { background: #155aa0; }
  .btn-csv  { background: #2d7a4f; } .btn-csv:hover  { background: #245f3e; }
  .btn:disabled { background: #999; cursor: not-allowed; }
  #kpis { display: flex; gap: 12px; padding: 16px 24px; flex-wrap: wrap; }
  .kpi { background: #fff; border: 1px solid #dde3ec; border-radius: 6px; padding: 12px 20px; min-width: 150px; flex: 1; }
  .kpi .kpi-label { font-size: 11px; color: #777; margin-bottom: 4px; }
  .kpi .kpi-value { font-size: 24px; font-weight: 700; }
  .kpi.red .kpi-value   { color: #c0392b; } .kpi.green .kpi-value { color: #1e7e34; }
  .kpi.blue .kpi-value  { color: #1a6fc4; } .kpi.amber .kpi-value { color: #c07a00; }
  #table-wrap { padding: 0 24px 24px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #dde3ec; font-size: 12px; }
  thead tr { background: #1a3a5c; color: #fff; }
  thead th { padding: 10px 12px; text-align: left; white-space: nowrap; cursor: pointer; }
  thead th:hover { background: #2a4f7a; }
  tbody tr:nth-child(even) { background: #f0f4fb; }
  tbody tr:hover { background: #e3ecf8; }
  tbody td { padding: 8px 12px; border-bottom: 1px solid #eaeff6; white-space: nowrap; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; }
  .b-red   { background: #fde8e8; color: #9b1c1c; }
  .b-green { background: #def7ec; color: #03543f; }
  .b-amber { background: #fef3c7; color: #78350f; }
  .b-gray  { background: #eee;    color: #555;    }
  #status-bar {
    padding: 10px 24px; font-size: 12px; color: #555;
    background: #fff; border-bottom: 1px solid #dde3ec;
    display: flex; align-items: center; gap: 8px; min-height: 36px;
  }
  .spinner {
    width: 14px; height: 14px; border: 2px solid #ccc;
    border-top-color: #1a6fc4; border-radius: 50%;
    animation: spin .7s linear infinite; flex-shrink: 0; display: none;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  #error-msg {
    background: #fde8e8; color: #9b1c1c; padding: 10px 24px;
    margin: 8px 24px; border-radius: 6px; display: none; font-size: 12px;
  }
</style>
</head>
<body>

<div id="header">
  <h1>Ignición activa durante carga de combustible</h1>
  <span id="subtitle">Iniciando...</span>
</div>

<div id="controls">
  <label>Desde: <input type="date" id="dateFrom"></label>
  <label>Hasta: <input type="date" id="dateTo"></label>
  <label>Vehículo:
    <select id="vehicleFilter"><option value="">Todos los vehículos</option></select>
  </label>
  <label>Estado:
    <select id="statusFilter">
      <option value="">Todos</option>
      <option value="RIESGO">Solo riesgo</option>
      <option value="OK">Solo OK</option>
    </select>
  </label>
  <button class="btn btn-run" id="btn-run" onclick="runReport()">&#9654; Ejecutar</button>
  <button class="btn btn-csv" onclick="exportCSV()">&#8595; CSV</button>
</div>

<div id="status-bar">
  <div class="spinner" id="spinner"></div>
  <span id="status-text">Esperando inicialización de MyGeotab...</span>
</div>
<div id="error-msg"></div>
<div id="kpis"></div>
<div id="table-wrap">
  <table id="report-table" style="display:none">
    <thead><tr>
      <th onclick="sortBy('plate')">Patente &#8597;</th>
      <th onclick="sortBy('driver')">Conductor &#8597;</th>
      <th onclick="sortBy('fuelTime')">Fecha/Hora Carga &#8597;</th>
      <th>Litros</th>
      <th>Odómetro en Carga (km)</th>
      <th onclick="sortBy('tripStart')">Último Viaje Iniciado &#8597;</th>
      <th>Fin de Viaje</th>
      <th>Ignición al cargar</th>
      <th onclick="sortBy('status')">Estado &#8597;</th>
    </tr></thead>
    <tbody id="report-body"></tbody>
  </table>
</div>

<script>
/* ══════════════════════════════════════════════════════════════
   GEOTAB ADD-IN — Ignición en Carga de Combustible
   Base  : intcesetti  |  Server: my.geotab.com
   ══════════════════════════════════════════════════════════════ */

var _api   = null;
var allRows = [];
var sortCol = 'fuelTime';
var sortDir = -1;

var IGNITION_DIAG_ID = 'DiagnosticIgnitionId';

/* ── Helpers UI ──────────────────────────────────────────────── */
function setStatus(msg, loading) {
  document.getElementById('status-text').textContent = msg;
  document.getElementById('spinner').style.display = loading ? 'block' : 'none';
  document.getElementById('btn-run').disabled = !!loading;
}

function showError(msg) {
  var el = document.getElementById('error-msg');
  el.style.display = 'block';
  el.innerHTML = '<b>Error:</b> ' + msg;
}

function hideError() {
  document.getElementById('error-msg').style.display = 'none';
}

function fmtDate(d) {
  if (!d) return '—';
  var dt = (d instanceof Date) ? d : new Date(d);
  if (isNaN(dt)) return '—';
  return dt.toLocaleDateString('es-AR') + ' ' +
         dt.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
}

function isoUTC(dateStr, endOfDay) {
  return dateStr + (endOfDay ? 'T23:59:59.000Z' : 'T00:00:00.000Z');
}

function setDefaultDates() {
  var now = new Date(), from = new Date(now);
  from.setDate(from.getDate() - 7);
  document.getElementById('dateTo').value   = now.toISOString().slice(0, 10);
  document.getElementById('dateFrom').value = from.toISOString().slice(0, 10);
}

/* ── Wrapper Promise para api.call ───────────────────────────── */
function apiGet(typeName, search) {
  return new Promise(function(resolve, reject) {
    if (!_api) { reject('API de MyGeotab no inicializada.'); return; }
    _api.call(
      'Get',
      { typeName: typeName, search: search },
      function(result) { resolve(result || []); },
      function(error)  { reject(typeof error === 'string' ? error : JSON.stringify(error)); }
    );
  });
}

/* ── Reporte principal ───────────────────────────────────────── */
function runReport() {
  if (!_api) {
    showError('La API de MyGeotab no está disponible. Verificá que el Add-In esté correctamente instalado.');
    return;
  }

  hideError();
  allRows = [];
  document.getElementById('report-table').style.display = 'none';
  document.getElementById('kpis').innerHTML = '';
  document.getElementById('report-body').innerHTML = '';

  var fromVal = document.getElementById('dateFrom').value;
  var toVal   = document.getElementById('dateTo').value;
  if (!fromVal || !toVal) { showError('Seleccioná ambas fechas.'); return; }

  var fromDate = isoUTC(fromVal, false);
  var toDate   = isoUTC(toVal,   true);
  var vFilter  = document.getElementById('vehicleFilter').value;

  /* Ejecutar las consultas en secuencia */
  setStatus('1/4 — Consultando cargas de combustible...', true);

  var fuelSearch = { fromDate: fromDate, toDate: toDate };
  if (vFilter) fuelSearch.deviceSearch = { id: vFilter };

  apiGet('FuelTransaction', fuelSearch)
    .then(function(fuels) {
      if (!fuels.length) {
        setStatus('No hay cargas en el período seleccionado.', false);
        return Promise.reject('SIN_DATOS');
      }
      setStatus('2/4 — Consultando estados de ignición...', true);

      /* Guardar fuels para la siguiente etapa */
      runReport._fuels = fuels;

      var ignSearch = {
        fromDate: fromDate,
        toDate:   toDate,
        diagnosticSearch: { id: IGNITION_DIAG_ID }
      };
      if (vFilter) ignSearch.deviceSearch = { id: vFilter };
      return apiGet('StatusData', ignSearch);
    })
    .then(function(ignData) {
      runReport._ignData = ignData;
      setStatus('3/4 — Consultando viajes...', true);

      var tripSearch = { fromDate: fromDate, toDate: toDate };
      if (vFilter) tripSearch.deviceSearch = { id: vFilter };
      return apiGet('Trip', tripSearch);
    })
    .then(function(trips) {
      runReport._trips = trips;
      setStatus('4/4 — Cargando datos de vehículos...', true);
      return apiGet('Device', {});
    })
    .then(function(devList) {
      var fuels   = runReport._fuels;
      var ignData = runReport._ignData;
      var trips   = runReport._trips;

      /* Indexar dispositivos */
      var devices = {};
      devList.forEach(function(d){ devices[d.id] = d; });

      /* Indexar ignición por vehículo, ordenado ASC */
      var ignByDevice = {};
      ignData.forEach(function(s) {
        var id = s.device && s.device.id;
        if (!id) return;
        if (!ignByDevice[id]) ignByDevice[id] = [];
        ignByDevice[id].push({ t: new Date(s.dateTime), on: s.data === 1 });
      });
      Object.keys(ignByDevice).forEach(function(id) {
        ignByDevice[id].sort(function(a, b){ return a.t - b.t; });
      });

      /* Indexar viajes por vehículo */
      var tripsByDevice = {};
      trips.forEach(function(t) {
        var id = t.device && t.device.id;
        if (!id) return;
        if (!tripsByDevice[id]) tripsByDevice[id] = [];
        tripsByDevice[id].push(t);
      });

      /* Cruzar cada carga */
      allRows = fuels.map(function(fuel) {
        var vid      = fuel.device && fuel.device.id;
        var dev      = vid ? devices[vid] : null;
        var plate    = dev ? (dev.licencePlate || dev.name || vid) : (vid || '—');
        var driver   = (fuel.driver && fuel.driver.name) ? fuel.driver.name : 'Sin asignar';
        var fuelTime = new Date(fuel.dateTime);
        var liters   = fuel.volume   != null ? parseFloat(fuel.volume).toFixed(1) : '—';
        var odomKm   = fuel.odometer != null ? Math.round(fuel.odometer / 1000)   : '—';

        /* Último estado de ignición <= fuelTime */
        var ignStatus  = '—';
        var ignEvents  = vid ? (ignByDevice[vid] || []) : [];
        for (var i = ignEvents.length - 1; i >= 0; i--) {
          if (ignEvents[i].t <= fuelTime) {
            ignStatus = ignEvents[i].on ? 'ON' : 'OFF';
            break;
          }
        }

        /* Último viaje previo a la carga */
        var vTrips   = vid ? (tripsByDevice[vid] || []) : [];
        var lastTrip = null;
        vTrips.forEach(function(t) {
          if (new Date(t.start) <= fuelTime) {
            if (!lastTrip || new Date(t.start) > new Date(lastTrip.start)) lastTrip = t;
          }
        });

        var tripStart = lastTrip ? new Date(lastTrip.start) : null;
        var tripEnd   = lastTrip ? (lastTrip.stop ? fmtDate(lastTrip.stop) : 'EN CURSO') : '—';
        var status    = ignStatus === 'ON'  ? 'RIESGO'
                      : ignStatus === 'OFF' ? 'OK'
                      : 'SIN_DATO';

        return { plate, driver, fuelTime, liters, odomKm,
                 tripStart, tripEnd, ignStatus, status, deviceId: vid };
      });

      populateVehicleFilter(fuels, devices);
      renderKpis();
      renderTable();
      setStatus('Reporte listo: ' + allRows.length + ' cargas analizadas.', false);
    })
    .catch(function(e) {
      if (e === 'SIN_DATOS') return;
      setStatus('Error al consultar la API.', false);
      showError(typeof e === 'string' ? e : (e.message || JSON.stringify(e)));
    });
}

/* ── KPIs ────────────────────────────────────────────────────── */
function renderKpis() {
  var total  = allRows.length;
  var riesgo = allRows.filter(function(r){ return r.status === 'RIESGO'; }).length;
  var ok     = allRows.filter(function(r){ return r.status === 'OK'; }).length;
  var pct    = total ? Math.round(riesgo / total * 100) : 0;
  document.getElementById('kpis').innerHTML =
    kpi('Total cargas',  total,     'blue')  +
    kpi('Ignición ON',   riesgo,    'red')   +
    kpi('Ignición OFF',  ok,        'green') +
    kpi('% Riesgo',      pct + '%', 'amber');
}

function kpi(label, val, cls) {
  return '<div class="kpi ' + cls + '"><div class="kpi-label">' + label +
         '</div><div class="kpi-value">' + val + '</div></div>';
}

/* ── Tabla ───────────────────────────────────────────────────── */
function renderTable() {
  var rows  = getFilteredSorted();
  var tbody = document.getElementById('report-body');
  tbody.innerHTML = '';
  rows.forEach(function(r) {
    var ignBadge = r.ignStatus === 'ON'  ? '<span class="badge b-red">ON</span>'
                 : r.ignStatus === 'OFF' ? '<span class="badge b-green">OFF</span>'
                 : '<span class="badge b-gray">—</span>';
    var stBadge  = r.status === 'RIESGO'  ? '<span class="badge b-red">⚠ RIESGO</span>'
                 : r.status === 'OK'      ? '<span class="badge b-green">✔ OK</span>'
                 : '<span class="badge b-amber">Sin dato</span>';
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><b>' + r.plate + '</b></td>' +
      '<td>' + r.driver + '</td>' +
      '<td>' + fmtDate(r.fuelTime) + '</td>' +
      '<td>' + r.liters + ' L</td>' +
      '<td>' + (r.odomKm !== '—' ? r.odomKm.toLocaleString('es-AR') + ' km' : '—') + '</td>' +
      '<td>' + (r.tripStart ? fmtDate(r.tripStart) : '—') + '</td>' +
      '<td>' + r.tripEnd + '</td>' +
      '<td>' + ignBadge + '</td>' +
      '<td>' + stBadge + '</td>';
    tbody.appendChild(tr);
  });
  document.getElementById('report-table').style.display = rows.length ? 'table' : 'none';
}

function getFilteredSorted() {
  var sf   = document.getElementById('statusFilter').value;
  var rows = allRows.slice();
  if (sf) rows = rows.filter(function(r){ return r.status === sf; });
  if (sortCol) {
    rows.sort(function(a, b) {
      var va = a[sortCol] instanceof Date ? a[sortCol].getTime() : (a[sortCol] || '');
      var vb = b[sortCol] instanceof Date ? b[sortCol].getTime() : (b[sortCol] || '');
      return va < vb ? -sortDir : va > vb ? sortDir : 0;
    });
  }
  return rows;
}

function sortBy(col) {
  sortDir = sortCol === col ? sortDir * -1 : 1;
  sortCol = col;
  renderTable();
}

function populateVehicleFilter(fuels, devices) {
  var seen = {}, sel = document.getElementById('vehicleFilter'), cur = sel.value;
  sel.innerHTML = '<option value="">Todos los vehículos</option>';
  fuels.forEach(function(f) {
    if (!f.device || seen[f.device.id]) return;
    seen[f.device.id] = true;
    var d   = devices[f.device.id];
    var opt = document.createElement('option');
    opt.value       = f.device.id;
    opt.textContent = d ? (d.licencePlate || d.name || f.device.id) : f.device.id;
    if (opt.value === cur) opt.selected = true;
    sel.appendChild(opt);
  });
}

document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('statusFilter').addEventListener('change', function() {
    if (allRows.length) renderTable();
  });
});

/* ── Export CSV ──────────────────────────────────────────────── */
function exportCSV() {
  var rows = getFilteredSorted();
  if (!rows.length) { showError('No hay datos para exportar.'); return; }
  var lines = [['Patente','Conductor','Fecha Carga','Litros','Odometro (km)',
                'Ultimo Viaje','Fin Viaje','Ignicion','Estado'].join(';')];
  rows.forEach(function(r) {
    lines.push([r.plate, r.driver, fmtDate(r.fuelTime), r.liters, r.odomKm,
      r.tripStart ? fmtDate(r.tripStart) : '', r.tripEnd, r.ignStatus, r.status].join(';'));
  });
  var a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(lines.join('\n'));
  a.download = 'ignicion_carga_' + new Date().toISOString().slice(0, 10) + '.csv';
  a.click();
}

/* ══════════════════════════════════════════════════════════════
   ENTRY POINT CORRECTO para MyGeotab Add-In
   Debe ser un OBJETO con initialize / focus / blur.
   MyGeotab llama a initialize() al montar el Add-In
   e inyecta el objeto `api` — SIN esto _api queda undefined.
   ══════════════════════════════════════════════════════════════ */
geotab.addin.ignicionEnCarga = {

  initialize: function(api, state, callback) {
    _api = api;
    setDefaultDates();
    setStatus('Listo. Seleccioná un rango y ejecutá el reporte.', false);
    document.getElementById('subtitle').textContent =
      'Base: intcesetti  |  my.geotab.com';
    if (typeof callback === 'function') callback();
  },

  focus: function(api, state) {
    _api = api;
  },

  blur: function() {}
};
</script>
</body>
</html>
